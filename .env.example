# API Configuration
REACT_APP_API_URL=http://localhost:3001/api

# Google OAuth Configuration
# Để lấy Google Client ID:
# 1. Truy cập https://console.developers.google.com/
# 2. Tạo project mới hoặc chọn project hiện có
# 3. Vào "Credentials" > "Create Credentials" > "OAuth 2.0 Client IDs"
# 4. Chọn "Web application"
# 5. Thêm authorized origins: http://localhost:3000, https://yourdomain.com
# 6. Copy Client ID và paste vào đây
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com